<Window x:Class="SonicTrack.V61.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonicTrack.V61"
        xmlns:wc="clr-namespace:SonicTrack.WaveCore"
        xmlns:shell="clr-namespace:SonicTrack.App.Shell"
        Title="SonicTrack V6.1 — 3D 频谱瀑布"
        Height="840" Width="1180"
        MinHeight="520" MinWidth="860"
        Background="#FFF5F6F8" BorderBrush="#FFF5F6F8"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
    <!-- Integrated app: light theme and self-drawn title bar. Controls, names, ranges and handlers are unchanged. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource LightCheckBox}"/>
        <Style TargetType="ToolTip" BasedOn="{StaticResource LightToolTip}"/>
        <Style TargetType="wc:SilverCoralSlider">
            <Setter Property="LightSurface" Value="True"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="-14,2,-14,0"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF2B2D31"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SliderHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7079"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <shell:ComponentTitleBar DockPanel.Dock="Top" Title="3D 频谱瀑布" Caption="V6.1"/>
    <DockPanel Margin="18,14,18,16">
        <StackPanel DockPanel.Dock="Top" Margin="2,0,2,12">
            <TextBlock x:Name="Status" Foreground="#FF6B7079" FontSize="12" Margin="0,0,0,0" TextWrapping="Wrap" Height="36"
                       Text="正在捕获本机音频。"/>
            <TextBlock Foreground="#FF9A9EA6" FontSize="12" Margin="0,2,0,0"
                       Text="柱子整体向左平移 · 高度与颜色保持记录值"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnDesktop" Content="打开桌面悬浮窗" Click="OnDesktopToggle" Padding="14,6"
                        Style="{StaticResource CoralButton}"
                        ToolTip="只显示彩色柱子。拖动柱子可移动窗口；右键可关闭。"/>
                <Button x:Name="BtnSaveParameters" Content="保存参数" Click="OnSaveParameters" Padding="14,6" Margin="10,0,0,0"
                        ToolTip="保存当前滑条参数和悬浮窗选项，下次启动自动恢复。"/>
                <CheckBox x:Name="CbDesktopTopmost" Content="悬浮窗置顶" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="OnDesktopOptions" Unchecked="OnDesktopOptions"/>
                <CheckBox x:Name="CbDesktopClickThrough" Content="鼠标穿透" Margin="16,0,0,0"
                          VerticalAlignment="Center" Checked="OnDesktopOptions" Unchecked="OnDesktopOptions"
                          ToolTip="开启后鼠标操作落到后方窗口；请在主窗口关闭或取消穿透。"/>
            </StackPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Right" Width="300" Margin="16,0,0,0">
            <Border CornerRadius="14" Background="White" Margin="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#1E2230"/>
                </Border.Effect>
            </Border>
            <Border Background="White" CornerRadius="14" BorderBrush="#FFEFEFF2" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,16,18,16">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="显示设置" Foreground="#FF2B2D31" FontSize="15" FontWeight="SemiBold"/>
                        <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource CoralBrush}"
                                   HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblHeightCompression" Text="柱高压缩 1.50" Style="{StaticResource SliderLabel}"/>
                        <wc:SilverCoralSlider x:Name="SlHeightCompression" Minimum="0" Maximum="4" Value="1.5"
                                SmallChange="0.05" LargeChange="0.25" ValueChanged="OnHeightCompressionChanged"
                                ToolTip="高柱压低更多，低柱压低更少；颜色保持原样。0 为原来的分贝柱高。"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="弱" Foreground="#FF8A8F98" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Grid.Column="1" Height="10" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#FF2A0840" Offset="0.14"/>
                                    <GradientStop Color="#FF1D4ED8" Offset="0.32"/>
                                    <GradientStop Color="#FF16A34A" Offset="0.55"/>
                                    <GradientStop Color="#FFF5D90A" Offset="0.78"/>
                                    <GradientStop Color="#FFDC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Grid.Column="2" Text="强" Foreground="#FF8A8F98" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblHistoryOffset" Style="{StaticResource SliderHint}"
                                   Text="回看位置：实时" VerticalAlignment="Center"/>
                        <wc:SilverCoralSlider x:Name="SlHistoryOffset" Minimum="0" Maximum="14" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnHistoryOffsetChanged"
                                ToolTip="0 为实时；增大数值查看更早的历史。历史长度决定可回看的范围，不改变柱子底座尺寸。"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblBlackOpacity" Text="内部黑柱不透明度：35%"
                                   Style="{StaticResource SliderHint}" VerticalAlignment="Center"/>
                        <wc:SilverCoralSlider x:Name="SlBlackOpacity" Minimum="0" Maximum="100" Value="35"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnBlackOpacityChanged"
                                ToolTip="仅调整桌面悬浮窗中彩柱之间的黑柱。0% 完全透明，100% 完全不透明；外围仍完全透明。"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblDensity" Style="{StaticResource SliderLabel}" Text="历史长度 120 列"/>
                        <wc:SilverCoralSlider x:Name="SlDensity" Minimum="120" Maximum="1000" Value="120"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                ValueChanged="OnDensityChanged"
                                ToolTip="保留的历史列数。每个分析结果单独保存为一列，不压缩时间，不改变正方形柱子的边长。"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblRows" Style="{StaticResource SliderLabel}" Text="频率分辨 120"/>
                        <wc:SilverCoralSlider x:Name="SlRows" Minimum="10" Maximum="120" Value="120"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnRowsChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblGain" Style="{StaticResource SliderLabel}" Text="增益系数 5.19"/>
                        <wc:SilverCoralSlider x:Name="SlGain" Minimum="1" Maximum="100" Value="5.19"
                                SmallChange="1" LargeChange="10"
                                ValueChanged="OnGainChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblRate" Style="{StaticResource SliderLabel}" Text="采样率 30 列/秒"/>
                        <wc:SilverCoralSlider x:Name="SlRate" Minimum="30" Maximum="500" Value="30"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OnRateChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblContrast" Style="{StaticResource SliderLabel}" Text="对比度 1.00"/>
                        <wc:SilverCoralSlider x:Name="SlContrast" Minimum="0.5" Maximum="3" Value="1"
                                SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="OnContrastChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblStability" Style="{StaticResource SliderLabel}" Text="新柱稳定 0 ms"/>
                        <wc:SilverCoralSlider x:Name="SlStability" Minimum="0" Maximum="120" Value="0"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ToolTip="仅稳定新输入的响度，历史柱子不会反复变形。设为 0 可关闭。"
                                ValueChanged="OnStabilityChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblYaw" Style="{StaticResource SliderLabel}" Text="水平 0°"/>
                        <wc:SilverCoralSlider x:Name="SlYaw" Minimum="-180" Maximum="180" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnYawChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblPitch" Style="{StaticResource SliderLabel}" Text="俯仰 80°"/>
                        <wc:SilverCoralSlider x:Name="SlPitch" Minimum="8" Maximum="85" Value="80"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnPitchChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblDist" Style="{StaticResource SliderLabel}" Text="距离 16"/>
                        <wc:SilverCoralSlider x:Name="SlDist" Minimum="4" Maximum="30" Value="16"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnDistChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblPanX" Style="{StaticResource SliderLabel}" Text="左右 -4.0"/>
                        <wc:SilverCoralSlider x:Name="SlPanX" Minimum="-5" Maximum="5" Value="-4"
                                SmallChange="0.1" LargeChange="1"
                                ValueChanged="OnPanXChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="LblPanY" Style="{StaticResource SliderLabel}" Text="上下 0.1"/>
                        <wc:SilverCoralSlider x:Name="SlPanY" Minimum="-5" Maximum="5" Value="0.1"
                                SmallChange="0.1" LargeChange="1"
                                ValueChanged="OnPanYChanged"/>
                    </StackPanel>
                    <Button Content="重置视角" Click="OnResetView" Padding="12,7"
                            ToolTip="恢复到上次保存的视角（水平、俯仰、距离、左右、上下和预览位置）；没有保存过的项恢复默认。"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
                <TextBlock Text="高频 12 kHz" Foreground="#FF8A8F98" FontSize="12"/>
                <TextBlock Text="时间 → 最新（默认视角）" HorizontalAlignment="Right" Foreground="#FF8A8F98" FontSize="12"/>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="低频 40 Hz" Foreground="#FF8A8F98" FontSize="12" Margin="10,6,0,0"/>
            <Border Background="#FF07080C" CornerRadius="10" ClipToBounds="True">
                    <local:Waterfall3DView x:Name="View" ToolTip="按住左键平移预览画面；相机和参数保持不变。点击重置视角可恢复到上次保存的位置。"/>
            </Border>
        </DockPanel>
    </DockPanel>
    </DockPanel>
</Window>
