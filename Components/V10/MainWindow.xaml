<Window x:Class="SonicTrack.WaveCore.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SonicTrack.WaveCore"
 xmlns:shell="clr-namespace:SonicTrack.App.Shell"
 Title="SonicTrack · GPU 桌面声波验证" Width="1280" Height="820" MinWidth="880" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="#F5F6F8" BorderBrush="#F5F6F8" FontFamily="{StaticResource UiFont}">
 <!-- Integrated app: light theme and self-drawn title bar. Controls, names and handlers are unchanged. -->
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2B2D31"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource LightComboBox}"><Setter Property="Margin" Value="0,7,0,16"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource LightCheckBox}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource LightToolTip}"/>
  <Style TargetType="local:SilverCoralSlider"><Setter Property="LightSurface" Value="True"/></Style>
 </Window.Resources>
 <DockPanel>
 <shell:ComponentTitleBar DockPanel.Dock="Top" Title="桌面声波" Caption="V10"/>
 <DockPanel Margin="20,14,20,16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
   <TextBlock Text="GPU 绘制 · 独立更新 · 参数即时生效与保存" Foreground="#8A8F98" FontSize="12.5"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock x:Name="DeviceStatus" Text="初始化…" Foreground="#6B7079" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="PerformanceStatus" Text="统计准备中…" Foreground="#6B7079" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="SaveStatus" Text="参数和悬浮窗位置自动保存" Foreground="#9A9EA6" FontSize="12" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid DockPanel.Dock="Right" Width="320" Margin="18,0,0,0">
   <Border CornerRadius="14" Background="White" Margin="1">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#1E2230"/></Border.Effect>
   </Border>
   <!-- The inset sits inside the ScrollViewer (as in V6.1) so slider thumbs and their shadows at
        either end are not cut off by the scroll viewport. -->
   <Border Background="White" CornerRadius="14" BorderBrush="#EFEFF2" BorderThickness="1">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18">
    <Button x:Name="OverlayButton" Content="打开桌面悬浮窗" Padding="12,9" Margin="0,0,0,18" Click="ToggleOverlay" Style="{StaticResource CoralButton}"/>
    <CheckBox x:Name="Antialiasing" Content="抗锯齿" Click="AntialiasingChanged"/>
    <TextBlock Text="目标更新频率"/>
    <ComboBox x:Name="TargetRate" SelectedIndex="3" SelectionChanged="TargetChanged">
     <ComboBoxItem Content="60 Hz"/><ComboBoxItem Content="120 Hz"/><ComboBoxItem Content="144 Hz"/><ComboBoxItem Content="240 Hz"/>
    </ComboBox>
    <TextBlock Text="信号来源"/>
    <ComboBox x:Name="Source" SelectedIndex="0" SelectionChanged="SourceChanged">
     <ComboBoxItem Content="本机播放音频"/><ComboBoxItem Content="演示波形"/><ComboBoxItem Content="复杂压力波形"/>
    </ComboBox>
    <StackPanel x:Name="ParameterPanel"/>
    <TextBlock Text="主声波颜色" Margin="0,8,0,0"/>
    <ComboBox x:Name="WaveColor" SelectedIndex="0" SelectionChanged="ColorChanged">
     <ComboBoxItem Content="珊瑚"/><ComboBoxItem Content="青蓝"/><ComboBoxItem Content="白色"/><ComboBoxItem Content="深灰"/>
    </ComboBox>
    <CheckBox x:Name="ShowUnderlay" Content="显示底层声波" Click="OptionsChanged"/>
    <TextBlock Text="底层声波颜色"/>
    <ComboBox x:Name="UnderlayColor" SelectedIndex="3" SelectionChanged="ColorChanged">
     <ComboBoxItem Content="珊瑚"/><ComboBoxItem Content="青蓝"/><ComboBoxItem Content="白色"/><ComboBoxItem Content="深灰"/>
    </ComboBox>
    <CheckBox x:Name="TopmostControl" Content="悬浮窗置顶" Click="OptionsChanged"/>
    <CheckBox x:Name="ClickThrough" Content="鼠标穿透" Click="OptionsChanged"/>
    <CheckBox x:Name="Backplate" Content="保护底板（自动选择对比色）" Click="OptionsChanged"/>
    <CheckBox x:Name="PreviewEnabled" Content="显示预览（关闭可减少双窗口负载）" Click="OptionsChanged"/>
    <TextBlock Text="预览背景"/>
    <ComboBox x:Name="BackgroundChoice" SelectedIndex="0" SelectionChanged="BackgroundChanged">
     <ComboBoxItem Content="深色"/><ComboBoxItem Content="白色"/><ComboBoxItem Content="与主声波同色"/>
    </ComboBox>
    <Button Content="重新连接音频" Padding="12,8" Click="Reconnect"/>
    <TextBlock Text="拖动悬浮窗调整位置，右键关闭。启用鼠标穿透后，使用上方按钮关闭。底层向右下各偏移 1 像素，主声波保持不透明。" Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Border CornerRadius="12" ClipToBounds="True">
  <Grid x:Name="ViewHost" Background="#101217" ClipToBounds="True">
   <TextBlock x:Name="PreviewHint" Text="预览已暂停，桌面悬浮窗继续更新" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FA9BA" Visibility="Collapsed"/>
  </Grid>
  </Border>
 </DockPanel>
 </DockPanel>
</Window>
