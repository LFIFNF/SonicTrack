<Window x:Class="SonicTrack.App.Shell.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SonicTrack.App.Shell"
        xmlns:wc="clr-namespace:SonicTrack.WaveCore"
        Title="音乐可视化" Width="1040" Height="660" MinWidth="820" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="24" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <shell:BoolToVisibility x:Key="Visible"/>
        <shell:BoolToVisibility x:Key="Hidden" Invert="True"/>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CoralTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="GroupUnderline" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource CoralBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="12,6,0,8"/>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CoralTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="wc:SilverCoralSlider">
            <Setter Property="LightSurface" Value="True"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="-14,2,-14,0"/>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type shell:ComponentEntry}">
            <Grid Margin="9">
                <!-- Soft shadow layer kept separate so the card content is not rendered through an effect. -->
                <Border CornerRadius="14" Background="White" Margin="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#1E2230"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="14" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="20,18,20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{Binding Icon}" Stroke="{StaticResource IconStrokeBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="12.5" Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,16,0,0" Height="150" CornerRadius="10" Background="#F3F4F6" ClipToBounds="True">
                            <Grid>
                                <shell:PreviewArt Kind="{Binding Preview}" Margin="14,12"/>
                                <!-- Running state (settings window / desktop overlay); opening and closing is done with the footer buttons. -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" CornerRadius="9" Background="White" Opacity="0.96"
                                        Padding="10,5,12,5" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#1E2230"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource CoralBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBodyBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,14,0,0" SizeChanged="OnCardFooterSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Children order matters for OnCardFooterSizeChanged: version tag, buttons. -->
                            <Border CornerRadius="6" Background="#F2F2F4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Secondary: opens the desktop overlay directly; becomes "关闭悬浮窗" while it runs. -->
                                <Button Style="{StaticResource OutlineCoralButton}" Padding="13,7" Click="OnToggleOverlay"
                                        AutomationProperties.Name="{Binding Name, StringFormat=打开 {0} 的桌面悬浮窗}"
                                        ToolTip="直接打开桌面悬浮窗，不需要先打开设置"
                                        Visibility="{Binding HasOverlay, Converter={StaticResource Hidden}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconOverlay}" Stroke="{StaticResource CoralTextBrush}" StrokeThickness="1.5" Width="13" Height="12"
                                              Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <TextBlock Text="打开悬浮窗" Margin="7,0,0,0" FontSize="13.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OutlineCoralButton}" Padding="13,7" Click="OnToggleOverlay"
                                        AutomationProperties.Name="{Binding Name, StringFormat=关闭 {0} 的桌面悬浮窗}"
                                        ToolTip="关闭桌面悬浮窗"
                                        Visibility="{Binding HasOverlay, Converter={StaticResource Visible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GlyphClose}" Stroke="{StaticResource CoralTextBrush}" StrokeThickness="1.6" Width="13" Height="9"
                                              Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="关闭悬浮窗" Margin="7,0,0,0" FontSize="13.5"/>
                                    </StackPanel>
                                </Button>
                                <!-- Primary: always "打开设置" (opens or shows the component's settings window). -->
                                <Button Style="{StaticResource CoralButton}" Padding="14,8" Margin="8,0,0,0" Click="OnOpenComponent"
                                        AutomationProperties.Name="{Binding Name, StringFormat=打开 {0} 设置}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Stroke="White" StrokeThickness="1.6" Width="13" Height="12"
                                              Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock Text="打开设置" Margin="7,0,0,0" FontSize="13.5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="ShadowHost" Margin="20">
        <!-- Frosted panel: translucent white over the desktop, rounded, soft shadow. -->
        <Border x:Name="Frame" CornerRadius="16" BorderThickness="1" BorderBrush="#D9FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F8FCFCFD" Offset="0"/>
                    <GradientStop Color="#F5F6F6F8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#1B1F2A"/>
            </Border.Effect>
        </Border>
        <!-- Frosted backdrop: the desktop wallpaper, blurred and washed with white (like Mica). -->
        <Grid x:Name="BackdropHost" IsHitTestVisible="False" Visibility="Collapsed">
            <!-- The wallpaper is blurred once at load time, so moving the window needs no live effect. -->
            <Rectangle x:Name="Backdrop" Margin="-60"/>
            <Rectangle Fill="#D1F8F8FA"/>
        </Grid>
        <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.08,0.05" GradientOrigin="0.08,0.05" RadiusX="0.55" RadiusY="0.7">
                    <GradientStop Color="#14F2604C" Offset="0"/>
                    <GradientStop Color="#00F2604C" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" CornerRadius="16,16,0,0" Background="#B3FFFFFF" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Path Data="{StaticResource IconAppBars}" Stroke="{StaticResource CoralBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock Text="音乐可视化" Margin="12,0,0,0" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource CaptionButton}" Content="{StaticResource GlyphMinimize}" ToolTip="最小化"
                                AutomationProperties.Name="最小化" Click="OnMinimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="{StaticResource GlyphMaximize}" ToolTip="最大化"
                                AutomationProperties.Name="最大化" Click="OnMaximize" Margin="4,0"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Content="{StaticResource GlyphClose}" ToolTip="关闭"
                                AutomationProperties.Name="关闭" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border CornerRadius="0,0,0,16" Background="#99FFFFFF" BorderBrush="#0F000000" BorderThickness="0,0,1,0">
                    <StackPanel Margin="12,20,12,16">
                        <TextBlock Text="组件" Style="{StaticResource GroupHeader}"/>
                        <Rectangle Style="{StaticResource GroupUnderline}"/>
                        <RadioButton x:Name="NavAll" Style="{StaticResource NavItem}" Tag="{StaticResource IconGrid}" Content="全部组件"
                                     IsChecked="True" Checked="OnNavigate"/>
                        <RadioButton x:Name="NavSpectrum" Style="{StaticResource NavItem}" Tag="{StaticResource IconWaterfall}" Content="频谱"
                                     Checked="OnNavigate"/>
                        <RadioButton x:Name="NavWave" Style="{StaticResource NavItem}" Tag="{StaticResource IconWave}" Content="声波"
                                     Checked="OnNavigate"/>

                        <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="8,14,8,16"/>
                        <TextBlock Text="窗口" Style="{StaticResource GroupHeader}"/>
                        <Rectangle Style="{StaticResource GroupUnderline}"/>
                        <RadioButton x:Name="NavOpen" Style="{StaticResource NavItem}" Tag="{StaticResource IconWindow}" Checked="OnNavigate">
                            <Grid>
                                <TextBlock Text="已打开"/>
                                <Border x:Name="OpenBadge" HorizontalAlignment="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                        Background="{StaticResource CoralBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="OpenCount" Text="0" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="8,14,8,16"/>
                        <TextBlock Text="更多" Margin="12,0,0,8" FontSize="14" Foreground="#33363C"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="{StaticResource IconInfo}" Content="关于"
                                     Checked="OnNavigate"/>
                        <RadioButton x:Name="NavDev" Style="{StaticResource NavItem}" Tag="{StaticResource IconDev}" Content="开发者选项"
                                     Checked="OnNavigate" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Main area -->
                <Border Grid.Column="1" CornerRadius="0,0,16,0" Background="#59EEEEF1">
                    <Grid Margin="28,22,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitle" Text="可视化组件" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"
                                           Background="Transparent" MouseLeftButtonDown="OnPageTitleMouseDown"/>
                                <TextBlock x:Name="PageSubtitle" Text="选择组件并在独立窗口中打开" FontSize="12.5" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="SearchArea" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="210" Height="38" CornerRadius="10" Background="White" BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1" x:Name="SearchFrame">
                                    <Grid>
                                        <Path Data="{StaticResource IconSearch}" Stroke="#5A5E66" StrokeThickness="1.5" Width="15" Height="15"
                                              Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="SearchPlaceholder" Text="搜索组件…" Margin="38,0,0,0" VerticalAlignment="Center"
                                                   Foreground="#9CA0A8" FontSize="13" IsHitTestVisible="False"/>
                                        <TextBox x:Name="SearchBox" Margin="36,0,10,0" VerticalAlignment="Center" BorderThickness="0"
                                                 Background="Transparent" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                                 CaretBrush="{StaticResource CoralBrush}" TextChanged="OnSearchChanged"
                                                 AutomationProperties.Name="搜索组件"
                                                 GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchFocus"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="FilterButton" Style="{StaticResource IconButton}" Margin="12,0,0,0" Background="White"
                                        ToolTip="筛选" AutomationProperties.Name="筛选" Click="OnFilterClick">
                                    <Path Data="{StaticResource IconFilter}" Stroke="#3A3D44" StrokeThickness="1.5" Width="16" Height="12"
                                          Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="FilterMenu" Placement="Bottom">
                                            <MenuItem Header="全部组件" Tag="all" IsCheckable="True" Click="OnFilterMenu"/>
                                            <MenuItem Header="频谱" Tag="spectrum" IsCheckable="True" Click="OnFilterMenu"/>
                                            <MenuItem Header="声波" Tag="wave" IsCheckable="True" Click="OnFilterMenu"/>
                                            <Separator/>
                                            <MenuItem Header="仅显示已打开" Tag="open" IsCheckable="True" Click="OnFilterMenu"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="-9,0,-9,0" Padding="0,0,0,18">
                                <shell:CardHost x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </shell:CardHost>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyHint" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
                                <Path Data="{StaticResource IconSearch}" Stroke="#C3C6CC" StrokeThickness="1.5" Width="34" Height="34" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyText" Text="没有匹配的组件" Margin="0,12,0,0" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- About -->
                            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,0,18">
                                    <Border CornerRadius="14" Background="White" Margin="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#1E2230"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="14" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="24,20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="AboutIcon" Width="40" Height="40"/>
                                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="SonicTrack 音乐可视化" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="AboutVersion" FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,18"/>
                                            <TextBlock x:Name="AboutBody" TextWrapping="Wrap" FontSize="13" LineHeight="23" Foreground="{StaticResource TextBodyBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Developer options -->
                            <ScrollViewer x:Name="DevPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,0,18">
                                    <Border CornerRadius="14" Background="White" Margin="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#1E2230"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="14" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="24,20">
                                        <StackPanel MaxWidth="540" HorizontalAlignment="Left">
                                            <TextBlock Text="滑条外观" Style="{StaticResource CardHeader}"/>
                                            <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource CoralBrush}"
                                                       HorizontalAlignment="Left" Margin="0,6,0,10"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="作用于 3D 频谱瀑布和桌面声波窗口里的所有滑条，已打开的窗口立即跟着变化。设置自动保存在程序目录的 app-settings.json。"/>

                                            <Grid Margin="0,18,0,0">
                                                <TextBlock Text="滑轨宽度" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding RailHeight, Source={x:Static shell:SliderAppearance.Current}, StringFormat={}{0:0} px}"/>
                                            </Grid>
                                            <wc:SilverCoralSlider x:Name="DevRailSlider" Minimum="8" Maximum="36" SmallChange="1" LargeChange="4"
                                                                  TickFrequency="1" IsSnapToTickEnabled="True"
                                                                  AutomationProperties.Name="滑轨宽度"
                                                                  Value="{Binding RailHeight, Source={x:Static shell:SliderAppearance.Current}, Mode=TwoWay}"/>
                                            <TextBlock Text="范围 8 – 36 px，默认 8 px" FontSize="11.5" Margin="0,2,0,0" Foreground="#9CA0A8"/>

                                            <Grid Margin="0,18,0,0">
                                                <TextBlock Text="圆点大小" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding ThumbSize, Source={x:Static shell:SliderAppearance.Current}, StringFormat={}{0:0} px}"/>
                                            </Grid>
                                            <wc:SilverCoralSlider x:Name="DevThumbSlider" Minimum="24" Maximum="64" SmallChange="1" LargeChange="4"
                                                                  TickFrequency="1" IsSnapToTickEnabled="True"
                                                                  AutomationProperties.Name="圆点大小"
                                                                  Value="{Binding ThumbSize, Source={x:Static shell:SliderAppearance.Current}, Mode=TwoWay}"/>
                                            <TextBlock Text="范围 24 – 64 px，默认 24 px" FontSize="11.5" Margin="0,2,0,0" Foreground="#9CA0A8"/>

                                            <Grid Margin="0,18,0,0">
                                                <TextBlock Text="滑轨阴影" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding ShadowStrength, Source={x:Static shell:SliderAppearance.Current}, StringFormat={}{0:0}%}"/>
                                            </Grid>
                                            <wc:SilverCoralSlider x:Name="DevShadowSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                                                  TickFrequency="5" IsSnapToTickEnabled="True"
                                                                  AutomationProperties.Name="滑轨阴影"
                                                                  Value="{Binding ShadowStrength, Source={x:Static shell:SliderAppearance.Current}, Mode=TwoWay}"/>
                                            <TextBlock Text="范围 0 – 200%，默认 40%，0 为无阴影" FontSize="11.5" Margin="0,2,0,0" Foreground="#9CA0A8"/>

                                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,20,0,16"/>
                                            <Button Content="恢复默认" Padding="18,8" HorizontalAlignment="Left" Click="OnResetSliderLook"
                                                    AutomationProperties.Name="恢复默认滑条外观"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Lightweight toast -->
                            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                                    CornerRadius="10" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Padding="16,10" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#1E2230"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource CoralBrush}" StrokeThickness="1.8" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
