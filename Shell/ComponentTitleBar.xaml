<UserControl x:Class="SonicTrack.App.Shell.ComponentTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="46" FontFamily="{StaticResource UiFont}">
    <Border Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Path Data="{StaticResource IconAppBars}" Stroke="{StaticResource CoralBrush}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/>
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border x:Name="CaptionChip" Margin="10,0,0,0" CornerRadius="6" Background="#F2F2F4" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptionText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="{StaticResource GlyphMinimize}"
                        ToolTip="最小化" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="{StaticResource GlyphMaximize}"
                        ToolTip="最大化" Click="OnMaximize" Margin="2,0"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="{StaticResource GlyphClose}"
                        ToolTip="关闭" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
