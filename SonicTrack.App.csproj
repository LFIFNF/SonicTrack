<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SonicTrack.App</RootNamespace>
    <AssemblyName>SonicTrack.App</AssemblyName>
    <Product>SonicTrack 音乐可视化</Product>
    <Version>1.0.4</Version>
    <ApplicationIcon>Assets\SonicTrack.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Component sources live under Components; integrated windows share the shell lifecycle and theme. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
